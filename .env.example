# Don't put any keys in code. See https://docs.stripe.com/keys-best-practices.
# Get these from the Stripe Dashboard -> https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Get this from the Stripe Dashboard -> https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Set this to the domain of your app
DOMAIN=http://localhost:3000

# Resend (admin mail + contact/report notifications)
RESEND_API_KEY=re_...
EMAIL_FROM=Eraiiz <noreply@eraiiz.com>
ADMIN_NOTIFY_EMAIL=projecterraiz@gmail.com
ADMIN_EMAILS=projecterraiz@gmail.com
# Optional: Resend Audience ID for checkout mailing-list opt-ins
RESEND_AUDIENCE_ID=

# Optional: JWT for a Render user with role=admin. Needed for full /admin/users list
# and deleting other sellers' products (Next email allowlist alone is not enough).
BACKEND_ADMIN_TOKEN=

# Secret admin entry link: https://www.eraiiz.com/gate/<ADMIN_GATE_TOKEN>
# Visiting it sets a cookie, then sign in to reach /admin. Without it, /admin is 404.
ADMIN_GATE_TOKEN=replace-with-long-random-token
